{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": ["packages/config/tsconfig/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!README.md"],
      "outputs": ["dist/**"]
    },
    "@inova/database#build": {
      "dependsOn": ["db:generate"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@inova/api#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "!**/*.test.ts"],
      "outputs": []
    },
    "@inova/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!README.md", "!.next-dev/**", "!.next-e2e/**"],
      "env": ["API_URL", "NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@inova/domain#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@inova/contracts#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
