{
  "name": "@inova/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test": "vitest run src",
    "start": "tsx src/server.ts",
    "catalog:import-images": "tsx scripts/import-material-images.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@inova/contracts": "*",
    "@inova/database": "*",
    "@inova/domain": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pdfkit": "^0.16.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@inova/config": "*",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
