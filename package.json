{
  "name": "inova-marmoraria",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@inova/api --filter=@inova/web --filter=@inova/domain --filter=@inova/contracts",
    "dev:web": "turbo run dev --filter=@inova/web --filter=@inova/domain --filter=@inova/contracts",
    "dev:api": "turbo run dev --filter=@inova/api --filter=@inova/domain --filter=@inova/contracts",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@inova/database",
    "db:migrate": "npm run db:migrate --workspace=@inova/database --",
    "db:deploy": "npm run db:deploy --workspace=@inova/database",
    "db:status": "npm run db:status --workspace=@inova/database",
    "db:seed": "turbo run db:seed --filter=@inova/database",
    "test:quote-persistence": "turbo run build --filter=@inova/api^... && tsx tests/scripts/verify-quote-edit.ts",
    "test:integration": "turbo run build --filter=@inova/api^... --filter=@inova/web^... && node tests/run-isolated.mjs integration",
    "test:e2e": "turbo run build --filter=@inova/api^... --filter=@inova/web^... && node tests/run-isolated.mjs e2e",
    "test:visual": "turbo run build --filter=@inova/web^... && node scripts/executar-testes-visuais.mjs",
    "test:all": "npm test && turbo run build --filter=@inova/api^... --filter=@inova/web^... && node tests/run-isolated.mjs all",
    "estrutura:migrar-pastas-locais": "node scripts/migrar-pastas-locais.mjs",
    "producao:instalar": "node scripts/producao.mjs instalar",
    "producao:atualizar": "node scripts/producao.mjs atualizar",
    "producao:voltar": "node scripts/producao.mjs voltar",
    "producao:status": "node scripts/producao.mjs status",
    "producao:logs": "node scripts/producao.mjs logs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@inova/database": "*",
    "@playwright/test": "^1.63.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "turbo": "^2.9.0",
    "vitest": "^3.0.5"
  }
}
